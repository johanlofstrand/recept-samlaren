rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users collection – own doc readable, admins can read all and write
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin();
    }

    // Only allow access to each user's own recipes
    match /recipes/{recipeId} {
      // Only read own recipes
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Allow creating recipes with data validation
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && isValidRecipe(request.resource.data)
                    && request.resource.data.keys().size() <= 15;

      // Allow updating recipes with data validation
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid
                    && isValidRecipe(request.resource.data)
                    && request.resource.data.keys().size() <= 15;

      // Only delete own recipes
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Validate recipe data structure and size limits
    function isValidRecipe(data) {
      return data.keys().hasAll(['ownerId', 'title', 'instructions', 'ingredients', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.ownerId.size() <= 128
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.ingredients is list
        && data.ingredients.size() <= 100
        && data.instructions is list
        && data.instructions.size() <= 100
        && (!('description' in data.keys()) || (data.description is string && data.description.size() <= 2000))
        && (!('imageUrl' in data.keys()) || (data.imageUrl is string && data.imageUrl.size() <= 2000))
        && (!('category' in data.keys()) || (data.category is string && data.category.size() <= 100))
        && (!('prepTime' in data.keys()) || data.prepTime is int || data.prepTime is float)
        && (!('cookTime' in data.keys()) || data.cookTime is int || data.cookTime is float)
        && (!('servings' in data.keys()) || data.servings is int || data.servings is float);
    }
  }
}
